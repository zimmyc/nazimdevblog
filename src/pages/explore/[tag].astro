---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TagPill from '../../components/TagPill.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = new Set();
  for (const p of posts) {
    for (const t of p.data.tags ?? []) tags.add(t);
  }
  return Array.from(tags).map((t) => ({ params: { tag: t } }));
}

const tag = Astro.params.tag;
const posts = (await getCollection('blog')).filter(p => (p.data.tags ?? []).includes(tag)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${tag} — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>Posts tagged "{tag}"</h1>
      <div>
        {posts.length === 0 ? (
          <p>No posts with this tag.</p>
        ) : (
          <ul>
            {posts.map(post => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <h3>{post.data.title}</h3>
                </a>
                <div style="margin-bottom:0.25rem">
                  <FormattedDate date={post.data.pubDate} />
                </div>
                <div>
                  {post.data.tags?.map(t => (
                    <TagPill tag={t} href={`/explore/${encodeURIComponent(t)}/`} />
                  ))}
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>
