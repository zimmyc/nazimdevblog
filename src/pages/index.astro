---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import TagPill from '../components/TagPill.astro';

const posts = (await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,2);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1 style="color: #d14280;">Where am I?</h1>
			<p>
				nazimdev.blog is a is a space ive created to think more about my thoughts and share my experiences to help people similar to me- people trying to navigate the gaming industry. 
			</p>

			<p>
				Here are some of my latest posts, and don't forget you can click on a post's <b>tags</b> to find other posts in the same category! 
			</p>
			
			<section>
				<h2 style="color: #d14280;">Latest posts</h2>
				<div class="grid gap-4 md:grid-cols-2">
					{posts.map(post => (
						<article class="group rounded-2xl border border-white/10 bg-white/5 p-4 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(209,66,128,0.25)]">
							<a href={`/blog/${post.id}/`} class="block text-inherit no-underline">
								{post.data.heroImage && (
									<Image class="mb-3 rounded-xl object-cover transition duration-500 group-hover:scale-[1.03]" src={post.data.heroImage} width={360} height={180} alt="" />
								)}
								<h3 class="text-[#d14280] transition-colors duration-300 group-hover:text-white">{post.data.title}</h3>
							</a>
							<div class="mb-1 text-sm text-[rgb(var(--gray))] transition-colors duration-300 group-hover:text-white">
								<FormattedDate date={post.data.pubDate} />
							</div>
							<p class="mt-1 mb-1">{post.data.description}</p>
							<div>
								{post.data.tags?.map((t: string) => (
									<TagPill tag={t} href={`/explore/${encodeURIComponent(t)}/`} />
								))}
							</div>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
