---
import { Image } from 'astro:assets';
import pawPrint from '../assets/paw-print.png';
import logo from '../assets/logo/nazimdevdotblogLogo.png';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/" class="brand-link"><Image src={logo} alt="Nazim Dev Blog" width={logo.width} height={logo.height} /></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">HOME</HeaderLink>
			<HeaderLink href="/blog">BLOG</HeaderLink>
			<HeaderLink href="/about">ABOUT</HeaderLink>
			<HeaderLink href="/projects">PROJECTS</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://www.linkedin.com/in/nazim-choudry/" target="_blank">
