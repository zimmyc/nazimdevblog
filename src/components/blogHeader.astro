			</a>
		</div>
		<div id="progress-bar">
	</div>
	</nav>
	<div id="progress-bar">
			<div id="progress-bar-fill"></div>
	</div>
</header>
<style>
	header {
		margin: 0;
		padding: 0 0.10em;
		--header-colour: #2f1e2f;
		background: var(--header-colour);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 10px 16px;
	}
	#progress-bar
	{
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 8px;
		background-color: #000000;
	}
	#progress-bar-fill
	{
		height: 100%;
		width: 0;
		animation-timeline: scroll(y);
    	animation-name: width;
		background-color: #853a8f;
	}
	@keyframes width {
    from { width: 0 }
    to   { width: 100% }
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand-link {
		display: inline flow-root;
		align-items: center;
	}
	.brand-link img {
		display: inline flow-root;
		max-height: 60px;
		width: auto;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2.2rem;
	}
	nav a {
		padding: 0.6em 1.2em;
		color: #F3DCA1;
		font-size: 1.4rem;
		font-weight: 600;
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		border-radius: 5px;
 		background-color: #000000;
  		padding: 0px 8px;  
		height: 34px;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
